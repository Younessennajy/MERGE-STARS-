# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=merge_stars
# Set to true for managed/cloud databases (Neon, Supabase, RDS, etc.)
DB_SSL=false

# ─── JWT ──────────────────────────────────────────────────────────────────────
# IMPORTANT: Replace these with strong random secrets in production.
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_ACCESS_TOKEN_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_TOKEN_SECRET_MIN_32_CHARS
JWT_REFRESH_EXPIRES_IN=7d
