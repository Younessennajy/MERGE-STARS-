# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:8080

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
# DB_HOST must be "postgres" (the Docker service name) when using docker compose
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=merge_stars
DB_SSL=false

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate strong secrets: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_ACCESS_TOKEN_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_TOKEN_SECRET_MIN_32_CHARS
JWT_REFRESH_EXPIRES_IN=7d
